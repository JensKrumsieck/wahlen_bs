{
	"name": "dashboard",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">= 22.16"
	},
	"packageManager": "npm@10.9.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@rollup/plugin-dsv": "^4.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"@types/d3-geo": "^3.1.0",
		"geojson-flatten": "^2.0.1",
		"german-election-polls": "^1.1.7",
		"mathjs": "^15.2.0",
		"ml-regression-multivariate-linear": "^2.0.4",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"svelte-loading-spinners": "^0.3.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"svelteplot": "^0.14.2",
		"swetrix": "^4.8.0"
	},
	"allowScripts": {
		"@tailwindcss/oxide@4.1.13": true,
		"esbuild@0.27.7": true
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
